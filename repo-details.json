  "projectDetails": {
    "purpose": "Recipe Development Tool for culinary professionals",
    "features": [
      "Recipe Management - Create, edit, and organize recipes with detailed instructions",
      "Ingredient Tracking - Manage ingredient inventory and sourcing",
      "Nutritional Analysis - Automatic nutritional information calculation",
      "Search & Filter - Find recipes by cuisine, dietary restrictions, preparation time",
      "Collaboration - Team comments, version history, and approval workflows",
      "Responsive Design - Works on desktop, tablet, and mobile devices"
    ]
  },
  "techStack": {
    "runtime": ".NET 8",
    "backend": "ASP.NET Core Minimal APIs",
    "database": "PostgreSQL (optional in-memory adapters for local/dev)",
    "language": "C#",
    "authentication": "JWT + refresh token lifecycle + RBAC permissions",
    "validation": "Application-layer input validation",
    "logging": "ASP.NET Core logging pipeline",
    "testing": "xUnit",
    "containerization": "Docker + Docker Compose",
    "orm": "Npgsql + focused persistence services"
  },
