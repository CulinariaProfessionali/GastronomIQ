  <projectDetails>
    <purpose>Recipe Development Tool for culinary professionals</purpose>
    <features>
      <feature>Recipe Management - Create, edit, and organize recipes with detailed instructions</feature>
      <feature>Ingredient Tracking - Manage ingredient inventory and sourcing</feature>
      <feature>Nutritional Analysis - Automatic nutritional information calculation</feature>
