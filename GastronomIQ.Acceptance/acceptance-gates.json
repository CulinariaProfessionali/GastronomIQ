{
  "release": "GastronomIQ RC8",
  "gates": [
    {
      "id": "BUILD",
      "name": "dotnet build",
      "command": "dotnet build --configuration Release",
      "required": true
    },
    {
      "id": "UNIT",
      "name": "unit tests",
      "command": "dotnet test --configuration Release --filter Category=Unit",
      "required": true
    },
    {
      "id": "MIGRATE_EMPTY",
      "name": "empty database migration",
      "command": "./scripts/test-migrations.sh",
      "required": true
    },
    {
      "id": "MIGRATE_REPLAY",
      "name": "migration replay",
      "command": "./scripts/test-migrations.sh --replay",
      "required": true
    },
    {
      "id": "TENANT",
      "name": "tenant isolation",
      "command": "dotnet test --filter Category=TenantIsolation",
      "required": true
    },
    {
      "id": "IDEMPOTENCY",
      "name": "idempotency",
      "command": "dotnet test --filter Category=Idempotency",
      "required": true
    },
    {
      "id": "AUDIT",
      "name": "audit persistence",
      "command": "dotnet test --filter Category=Audit",
      "required": true
    },
    {
      "id": "INVENTORY",
      "name": "inventory transaction",
      "command": "dotnet test --filter Category=Inventory",
      "required": true
    },
    {
      "id": "PROCUREMENT",
      "name": "procurement to inventory",
      "command": "dotnet test --filter Category=Procurement",
      "required": true
    },
    {
      "id": "PRODUCTION",
      "name": "production to inventory",
      "command": "dotnet test --filter Category=Production",
      "required": true
    },
    {
      "id": "MENU",
      "name": "menu engineering",
      "command": "dotnet test --filter Category=MenuEngineering",
      "required": true
    },
    {
      "id": "REPORTING",
      "name": "reporting",
      "command": "dotnet test --filter Category=Reporting",
      "required": true
    },
    {
      "id": "ROLLBACK",
      "name": "transaction rollback",
      "command": "dotnet test --filter Category=Rollback",
      "required": true
    },
    {
      "id": "E2E",
      "name": "end to end culinary workflow",
      "command": "dotnet test --filter Category=EndToEnd",
      "required": true
    }
  ]
}